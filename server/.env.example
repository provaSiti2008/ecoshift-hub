# Porta del server (opzionale, default 3000)
# PORT=3000

# ========== Supabase (PostgreSQL) ==========
# Copia la connection string da Supabase:
# Dashboard → Project Settings → Database → Connection string → URI
# Usa "Connection pooling" (porta 6543) per produzione, oppure "Direct connection" (5432)
# Esempio: postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# In alternativa puoi usare:
# DATABASE_URL=postgresql://...
# POSTGRES_URL=postgresql://...

# Se non imposti nessuna URL, il server userà SQLite locale (file server/ecoshift.db)
